{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "entreno-en-casa",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entreno-en-casa",
      "database_id": "fbb7e329-a10a-4153-b188-1a6cab18212d",
      "migrations_dir": "migrations"
    }
  ]
}
